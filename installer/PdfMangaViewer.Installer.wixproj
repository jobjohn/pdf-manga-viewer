<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!-- build-installer.ps1 から -p:AppVersion=x.y.z で渡す -->
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <DefineConstants>AppVersion=$(AppVersion)</DefineConstants>
    <OutputName>PdfMangaViewer-Setup-$(AppVersion)</OutputName>
    <OutputPath>dist\</OutputPath>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Per-user install only; ICE91 is expected. ICE03 flags a few .mui language IDs. -->
    <SuppressIces>ICE03;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
