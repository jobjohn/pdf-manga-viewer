<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="PDF Manga Viewer"
      Manufacturer="PdfMangaViewer"
      Version="$(var.AppVersion)"
      UpgradeCode="842FE880-FF45-4A5F-9470-C251764A2CE3"
      Scope="perUser"
      Language="1041"
      Codepage="932">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Install per user without requiring elevation -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Property Id="ARPCOMMENTS" Value="PDF manga viewer for Windows" />

    <!-- 「アプリと機能」に表示するアイコン -->
    <Icon Id="AppIcon.ico" SourceFile="..\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PdfMangaViewer" />
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="PDF Manga Viewer" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="PdfFileAssociation" />
    </Feature>
  </Package>

  <!--
    PDF の関連付け。既定のアプリを勝手に変えることはせず、
    「プログラムから開く」と「設定 > 既定のアプリ」の候補に出るよう登録だけ行う。
  -->
  <Fragment>
    <Component Id="PdfFileAssociation" Directory="INSTALLFOLDER" Guid="5D3C1E2A-8B47-4F1D-9C6E-2A7B3F4D8E91">
      <!-- ProgID -->
      <RegistryKey Root="HKCU" Key="Software\Classes\PdfMangaViewer.pdf">
        <RegistryValue Type="string" Value="PDF ドキュメント (PDF Manga Viewer)" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="PDF ドキュメント" />
      </RegistryKey>
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\PdfMangaViewer.pdf\DefaultIcon"
          Type="string"
          Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot;,0" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\PdfMangaViewer.pdf\shell\open\command"
          Type="string"
          Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot; &quot;%1&quot;" />

      <!-- 「プログラムから開く」の候補 -->
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\.pdf\OpenWithProgids"
          Name="PdfMangaViewer.pdf"
          Type="string"
          Value="" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\.cbz\OpenWithProgids"
          Name="PdfMangaViewer.cbz"
          Type="string"
          Value="" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\.zip\OpenWithProgids"
          Name="PdfMangaViewer.cbz"
          Type="string"
          Value="" />
      <RegistryKey Root="HKCU" Key="Software\Classes\PdfMangaViewer.cbz">
        <RegistryValue Type="string" Value="コミックアーカイブ (PDF Manga Viewer)" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="コミックアーカイブ" />
      </RegistryKey>
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\PdfMangaViewer.cbz\DefaultIcon"
          Type="string"
          Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot;,0" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\PdfMangaViewer.cbz\shell\open\command"
          Type="string"
          Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot; &quot;%1&quot;" />
      <RegistryKey Root="HKCU" Key="Software\Classes\Applications\PdfMangaViewer.exe">
        <RegistryValue Name="FriendlyAppName" Type="string" Value="PDF Manga Viewer" />
        <RegistryValue Key="SupportedTypes" Name=".pdf" Type="string" Value="" />
        <RegistryValue Key="SupportedTypes" Name=".cbz" Type="string" Value="" />
        <RegistryValue Key="SupportedTypes" Name=".zip" Type="string" Value="" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot; &quot;%1&quot;" />
      </RegistryKey>

      <!-- 「設定 > アプリ > 既定のアプリ」に表示するための登録 -->
      <RegistryKey Root="HKCU" Key="Software\PdfMangaViewer\Capabilities">
        <RegistryValue Name="ApplicationName" Type="string" Value="PDF Manga Viewer" />
        <RegistryValue Name="ApplicationDescription" Type="string" Value="PDF・ZIP/CBZ の漫画を画面いっぱいに表示するビューワ" />
        <RegistryValue Name="ApplicationIcon" Type="string" Value="&quot;[INSTALLFOLDER]PdfMangaViewer.exe&quot;,0" />
        <RegistryValue Key="FileAssociations" Name=".pdf" Type="string" Value="PdfMangaViewer.pdf" />
        <RegistryValue Key="FileAssociations" Name=".cbz" Type="string" Value="PdfMangaViewer.cbz" />
      </RegistryKey>
      <RegistryValue
          Root="HKCU"
          Key="Software\RegisteredApplications"
          Name="PDF Manga Viewer"
          Type="string"
          Value="Software\PdfMangaViewer\Capabilities"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="PDF Manga Viewer">
        <Component Id="StartMenuShortcut" Guid="EC53B7CD-788F-419B-BA23-A371BCDC9442">
          <Shortcut
              Id="StartMenuShortcutLnk"
              Name="PDF Manga Viewer"
              Description="PDF Manga Viewer $(var.AppVersion)"
              Target="[INSTALLFOLDER]PdfMangaViewer.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\PdfMangaViewer"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0B41AA80-D937-462A-8CE0-D61396CC211C">
        <Shortcut
            Id="DesktopShortcutLnk"
            Name="PDF Manga Viewer"
            Description="PDF Manga Viewer $(var.AppVersion)"
            Target="[INSTALLFOLDER]PdfMangaViewer.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\PdfMangaViewer"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
