<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdfMangaViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfMangaViewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PDF Manga Viewer"
    mc:Ignorable="d">

    <!-- ContentControl はキーボードフォーカスを受け取るための土台 -->
    <ContentControl
        x:Name="RootHost"
        Padding="0"
        Background="#0A0A0C"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        UseSystemFocusVisuals="False">

        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="LeftKey_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="RightKey_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="UpKey_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="DownKey_Invoked" />
            <KeyboardAccelerator Key="PageUp" Invoked="UpKey_Invoked" />
            <KeyboardAccelerator Key="PageDown" Invoked="DownKey_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="NextKey_Invoked" />
            <KeyboardAccelerator Key="Space" Modifiers="Shift" Invoked="PreviousKey_Invoked" />
            <KeyboardAccelerator Key="Home" Invoked="FirstPageKey_Invoked" />
            <KeyboardAccelerator Key="End" Invoked="LastPageKey_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenKey_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeKey_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenFileKey_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OpenFolderKey_Invoked" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="GoToPageKey_Invoked" />
            <KeyboardAccelerator Key="S" Invoked="ShiftSpreadKey_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="RotateCwKey_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Shift" Invoked="RotateCcwKey_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="ThumbnailKey_Invoked" />
            <KeyboardAccelerator Key="PageUp" Modifiers="Control" Invoked="PrevVolumeKey_Invoked" />
            <KeyboardAccelerator Key="PageDown" Modifiers="Control" Invoked="NextVolumeKey_Invoked" />
            <KeyboardAccelerator Key="Add" Invoked="ZoomInKey_Invoked" />
            <KeyboardAccelerator Key="Subtract" Invoked="ZoomOutKey_Invoked" />
            <KeyboardAccelerator Key="Number0" Invoked="ZoomResetKey_Invoked" />
            <KeyboardAccelerator Key="NumberPad0" Invoked="ZoomResetKey_Invoked" />
        </ContentControl.KeyboardAccelerators>

        <Grid
            x:Name="RootGrid"
            AllowDrop="True"
            Background="#0A0A0C"
            DoubleTapped="RootGrid_DoubleTapped"
            DragEnter="RootGrid_DragEnter"
            DragLeave="RootGrid_DragLeave"
            DragOver="RootGrid_DragOver"
            Drop="RootGrid_Drop"
            Loaded="RootGrid_Loaded"
            PointerCanceled="RootGrid_PointerReleased"
            PointerCaptureLost="RootGrid_PointerReleased"
            PointerExited="RootGrid_PointerExited"
            PointerMoved="RootGrid_PointerMoved"
            PointerPressed="RootGrid_PointerPressed"
            PointerReleased="RootGrid_PointerReleased"
            PointerWheelChanged="RootGrid_PointerWheelChanged"
            RightTapped="RootGrid_RightTapped"
            SizeChanged="RootGrid_SizeChanged">

            <!-- ズーム・パン・回転の対象コンテナ -->
            <Grid
                x:Name="ZoomContainer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="ZoomTransform" />
                </Grid.RenderTransform>

                <!-- ページ本体。Stretch=Uniform なので縦長・横長どちらでも画面内に収まる -->
                <Image
                    x:Name="PageImage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform" />

                <!-- 見開き表示（2ページを並べる） -->
                <StackPanel
                    x:Name="SpreadPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Image
                        x:Name="SpreadLeftImage"
                        Stretch="Uniform" />
                    <Image
                        x:Name="SpreadRightImage"
                        Stretch="Uniform" />
                </StackPanel>
            </Grid>

            <!-- 何も開いていないときの案内 -->
            <StackPanel
                x:Name="EmptyState"
                MaxWidth="520"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Border
                    Width="88"
                    Height="88"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Background="#14FFFFFF"
                    CornerRadius="24">
                    <FontIcon
                        FontSize="40"
                        Foreground="#B3FFFFFF"
                        Glyph="&#xE8A5;" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#F5FFFFFF"
                    Text="PDF Manga Viewer" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#99FFFFFF"
                    Text="PDF・ZIP / CBZ・画像フォルダを画面いっぱいに表示します" />

                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Padding="24,10"
                        Click="OpenButton_Click"
                        Content="ファイルを開く"
                        FontSize="14"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Padding="20,10"
                        Click="OpenFolderButton_Click"
                        Content="フォルダを開く"
                        FontSize="14" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#66FFFFFF"
                    Text="ここにファイルやフォルダをドラッグ＆ドロップ  /  Ctrl+O" />

                <!-- 最近開いたファイル -->
                <Border
                    x:Name="RecentFilesContainer"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    Background="#10FFFFFF"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Margin="4,0,0,2"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#99FFFFFF"
                            Text="最近開いたファイル" />
                        <StackPanel x:Name="RecentFilesList" Spacing="2" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 読み込み中 -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="#D9FFFFFF"
                IsActive="False"
                Visibility="Collapsed" />

            <!-- ファイル名チップ（操作バーと一緒に出現） -->
            <Border
                x:Name="FileChip"
                Margin="18"
                Padding="12,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B316161A"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="11"
                        Foreground="#99FFFFFF"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        x:Name="FileNameText"
                        MaxWidth="480"
                        FontSize="12"
                        Foreground="#CCFFFFFF"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- ズーム倍率チップ（拡大中のみ表示） -->
            <Border
                x:Name="ZoomBadge"
                Margin="18"
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#CC16161A"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ZoomBadgeText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#E6FFFFFF" />
            </Border>

            <!-- 右下のページ番号（トグルでオンのときだけ常時表示） -->
            <TextBlock
                x:Name="CornerPageNumber"
                Margin="0,0,16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="#59FFFFFF"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!-- 単ページ表示のときの縦の進捗バー（上が先頭）。操作バーと一緒に出現 -->
            <Grid
                x:Name="VerticalProgressHitArea"
                Width="24"
                Margin="0,56,10,56"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="False"
                Opacity="0"
                PointerCanceled="ProgressHitArea_PointerReleased"
                PointerCaptureLost="ProgressHitArea_PointerReleased"
                PointerMoved="ProgressHitArea_PointerMoved"
                PointerPressed="ProgressHitArea_PointerPressed"
                PointerReleased="ProgressHitArea_PointerReleased"
                ToolTipService.ToolTip="クリック・ドラッグでページ移動"
                Visibility="Collapsed">
                <Border
                    Width="4"
                    HorizontalAlignment="Center"
                    Background="#33FFFFFF"
                    CornerRadius="2" />
                <Grid Width="4" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="VerticalProgressDoneRow" Height="0*" />
                        <RowDefinition x:Name="VerticalProgressRestRow" Height="1*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>
            </Grid>

            <!-- シークバー操作中のページ番号プレビュー -->
            <Border
                x:Name="SeekPreviewBadge"
                Padding="10,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EB1A1A20"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SeekPreviewTransform" />
                </Border.RenderTransform>
                <TextBlock
                    x:Name="SeekPreviewText"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#F5FFFFFF" />
            </Border>

            <!-- 次巻案内バナー（最終ページ到達時にさらに進もうとしたときに表示） -->
            <Border
                x:Name="NextVolumeBanner"
                Margin="18,0,18,108"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#EB1A1A22"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        x:Name="NextVolumeText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#F2FFFFFF"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Padding="14,5"
                        Click="OpenPendingNextVolume_Click"
                        Content="次の巻を開く"
                        FontSize="12"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DismissNextVolumeBanner_Click"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Foreground="#B3FFFFFF" />
                </StackPanel>
            </Border>

            <!-- 下部の操作バー -->
            <Border
                x:Name="ControlsBar"
                Margin="18"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#D91A1A1E"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                IsHitTestVisible="False"
                Opacity="0">
                <StackPanel Spacing="6">
                    <!-- 全体の進捗（右綴じのときは右から伸びる） -->
                    <Grid
                        x:Name="ProgressHitArea"
                        Height="16"
                        Margin="8,0"
                        Background="Transparent"
                        PointerCanceled="ProgressHitArea_PointerReleased"
                        PointerCaptureLost="ProgressHitArea_PointerReleased"
                        PointerMoved="ProgressHitArea_PointerMoved"
                        PointerPressed="ProgressHitArea_PointerPressed"
                        PointerReleased="ProgressHitArea_PointerReleased"
                        ToolTipService.ToolTip="クリック・ドラッグでページ移動">
                        <ProgressBar
                            x:Name="ReadingProgress"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Maximum="1"
                            Minimum="0"
                            Value="0" />
                    </Grid>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="PrevButton"
                            Click="PrevButton_Click"
                            Content="&#xE76B;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="前のページ (←)" />

                        <Button
                            x:Name="NextButton"
                            Click="NextButton_Click"
                            Content="&#xE76C;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="次のページ (→)" />

                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            Background="#26FFFFFF" />

                        <Button
                            x:Name="PageLabelButton"
                            MinWidth="88"
                            Padding="8,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PageLabelButton_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="クリックでページ指定移動 (Ctrl+G)">
                            <TextBlock
                                x:Name="PageLabel"
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="#F2FFFFFF"
                                Text="0 / 0"
                                TextAlignment="Center" />
                        </Button>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            Background="#26FFFFFF" />

                        <DropDownButton
                            x:Name="SpreadButton"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="見開き: なし"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            ToolTipService.ToolTip="見開きの表示方法を変更">
                            <DropDownButton.Flyout>
                                <MenuFlyout
                                    Closed="ControlsFlyout_Closed"
                                    Opening="ControlsFlyout_Opening"
                                    Placement="Top">
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadOffItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="Off"
                                        Text="単ページ" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadCoverItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="CoverSingle"
                                        Text="見開き（表紙のみ単独）" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadPairItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="PairFromStart"
                                        Text="見開き（1ページ目から2枚ずつ）" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadFirstTwoItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="FirstTwoSingle"
                                        Text="見開き（1・2ページ目のみ単独）" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="ShiftSpreadMenuItem"
                                        Click="ShiftSpreadMenuItem_Click"
                                        Text="見開きを1ページずらす (S)" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="AutoLandscapeMenuItem"
                                        Click="AutoLandscapeMenuItem_Click"
                                        IsChecked="True"
                                        Text="横長ページを自動で単独表示" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <ToggleButton
                            x:Name="RtlToggle"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RtlToggle_Click"
                            Content="右綴じ"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            IsChecked="True"
                            ToolTipService.ToolTip="右から左に表示中（クリックで左から右へ）" />

                        <Button
                            x:Name="ThumbnailButton"
                            Click="ThumbnailButton_Click"
                            Content="&#xE80A;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="サムネイル一覧 (T)" />

                        <Button
                            x:Name="RotateButton"
                            Click="RotateButton_Click"
                            Content="&#xE7AD;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="90°回転 (R)" />

                        <DropDownButton
                            x:Name="OpenMenuButton"
                            MinWidth="0"
                            Padding="8,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Foreground="#F2FFFFFF"
                            ToolTipService.ToolTip="開く / 前後の巻へ移動">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE8E5;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout
                                    Closed="ControlsFlyout_Closed"
                                    Opening="OpenMenuFlyout_Opening"
                                    Placement="Top">
                                    <MenuFlyoutItem
                                        Click="OpenButton_Click"
                                        Text="ファイルを開く (Ctrl+O)" />
                                    <MenuFlyoutItem
                                        Click="OpenFolderButton_Click"
                                        Text="フォルダを開く (Ctrl+Shift+O)" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="PrevVolumeMenuItem"
                                        Click="PrevVolumeMenuItem_Click"
                                        Text="前の巻へ (Ctrl+PageUp)" />
                                    <MenuFlyoutItem
                                        x:Name="NextVolumeMenuItem"
                                        Click="NextVolumeMenuItem_Click"
                                        Text="次の巻へ (Ctrl+PageDown)" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem
                                        x:Name="RecentFilesSubMenu"
                                        Text="最近開いたファイル" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <DropDownButton
                            x:Name="MoreOptionsButton"
                            MinWidth="0"
                            Padding="8,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Foreground="#F2FFFFFF"
                            ToolTipService.ToolTip="表示・操作設定">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE712;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout
                                    Closed="ControlsFlyout_Closed"
                                    Opening="ControlsFlyout_Opening"
                                    Placement="Top">
                                    <ToggleMenuFlyoutItem
                                        x:Name="ReverseKeysMenuItem"
                                        Click="ReverseKeysMenuItem_Click"
                                        IsChecked="True"
                                        Text="キー反転（←で次ページ）" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="PageNumberMenuItem"
                                        Click="PageNumberMenuItem_Click"
                                        Text="右下にページ番号を表示" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="ClickNavMenuItem"
                                        Click="ClickNavMenuItem_Click"
                                        Text="画面の左右クリックでページ送り" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="ZoomInMenuItem_Click"
                                        Text="拡大 (+ / Ctrl+ホイール)" />
                                    <MenuFlyoutItem
                                        Click="ZoomOutMenuItem_Click"
                                        Text="縮小 (- / Ctrl+ホイール)" />
                                    <MenuFlyoutItem
                                        Click="ZoomResetMenuItem_Click"
                                        Text="ズームをリセット (0)" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button
                            x:Name="FullScreenButton"
                            Click="FullScreenButton_Click"
                            Content="&#xE740;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="全画面 (F11)" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- サムネイル一覧オーバーレイ -->
            <Grid
                x:Name="ThumbnailOverlay"
                Background="#F00A0A0D"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="24,16"
                    Background="#CC121216"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#F5FFFFFF"
                            Text="ページ一覧" />
                        <TextBlock
                            x:Name="ThumbnailSummaryText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#99FFFFFF" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="CloseThumbnailsButton_Click"
                        Content="&#xE711;"
                        Style="{StaticResource ViewerIconButtonStyle}"
                        ToolTipService.ToolTip="閉じる (Esc / T)" />
                </Grid>

                <GridView
                    x:Name="ThumbnailGridView"
                    Grid.Row="1"
                    Padding="20"
                    ContainerContentChanging="ThumbnailGridView_ContainerContentChanging"
                    IsItemClickEnabled="True"
                    ItemClick="ThumbnailGridView_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="156"
                                Height="228"
                                Margin="6"
                                Padding="6"
                                Background="#18FFFFFF"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding Image}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="#CCFFFFFF"
                                        Text="{Binding PageLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- ドラッグ中のオーバーレイ -->
            <Border
                x:Name="DropOverlay"
                Background="#B30A0A0C"
                BorderBrush="#FF60CDFF"
                BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="40"
                        Foreground="#FF60CDFF"
                        Glyph="&#xE8E5;" />
                    <TextBlock
                        FontSize="18"
                        Foreground="#F2FFFFFF"
                        Text="PDF・ZIP / CBZ・画像フォルダをドロップして開く" />
                </StackPanel>
            </Border>
        </Grid>
    </ContentControl>
</Window>
