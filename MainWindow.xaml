<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdfMangaViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PDF Manga Viewer"
    mc:Ignorable="d">

    <!-- ContentControl はキーボードフォーカスを受け取るための土台 -->
    <ContentControl
        x:Name="RootHost"
        Padding="0"
        Background="#0A0A0C"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        UseSystemFocusVisuals="False">

        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="LeftKey_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="RightKey_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="UpKey_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="DownKey_Invoked" />
            <KeyboardAccelerator Key="PageUp" Invoked="UpKey_Invoked" />
            <KeyboardAccelerator Key="PageDown" Invoked="DownKey_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="NextKey_Invoked" />
            <KeyboardAccelerator Key="Space" Modifiers="Shift" Invoked="PreviousKey_Invoked" />
            <KeyboardAccelerator Key="Home" Invoked="FirstPageKey_Invoked" />
            <KeyboardAccelerator Key="End" Invoked="LastPageKey_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenKey_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenFileKey_Invoked" />
        </ContentControl.KeyboardAccelerators>

        <Grid
            x:Name="RootGrid"
            AllowDrop="True"
            Background="#0A0A0C"
            DragEnter="RootGrid_DragEnter"
            DragLeave="RootGrid_DragLeave"
            DragOver="RootGrid_DragOver"
            Drop="RootGrid_Drop"
            Loaded="RootGrid_Loaded"
            PointerExited="RootGrid_PointerExited"
            PointerMoved="RootGrid_PointerMoved"
            PointerPressed="RootGrid_PointerPressed"
            PointerWheelChanged="RootGrid_PointerWheelChanged"
            SizeChanged="RootGrid_SizeChanged">

            <!-- ページ本体。Stretch=Uniform なので縦長・横長どちらでも画面内に収まる -->
            <Image
                x:Name="PageImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform" />

            <!-- 見開き表示（2ページを並べる） -->
            <StackPanel
                x:Name="SpreadPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <Image
                    x:Name="SpreadLeftImage"
                    Stretch="Uniform" />
                <Image
                    x:Name="SpreadRightImage"
                    Stretch="Uniform" />
            </StackPanel>

            <!-- 何も開いていないときの案内 -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Border
                    Width="88"
                    Height="88"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Background="#14FFFFFF"
                    CornerRadius="24">
                    <FontIcon
                        FontSize="40"
                        Foreground="#B3FFFFFF"
                        Glyph="&#xE8A5;" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#F5FFFFFF"
                    Text="PDF Manga Viewer" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#99FFFFFF"
                    Text="PDFを読み込んで、画面いっぱいに表示します" />

                <Button
                    Margin="0,12,0,0"
                    Padding="28,10"
                    HorizontalAlignment="Center"
                    Click="OpenButton_Click"
                    Content="PDFを開く"
                    FontSize="14"
                    Style="{StaticResource AccentButtonStyle}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#66FFFFFF"
                    Text="ここにPDFをドラッグ＆ドロップ  /  Ctrl+O" />
            </StackPanel>

            <!-- 読み込み中 -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="#D9FFFFFF"
                IsActive="False"
                Visibility="Collapsed" />

            <!-- ファイル名チップ（操作バーと一緒に出現） -->
            <Border
                x:Name="FileChip"
                Margin="18"
                Padding="12,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B316161A"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="11"
                        Foreground="#99FFFFFF"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        x:Name="FileNameText"
                        MaxWidth="480"
                        FontSize="12"
                        Foreground="#CCFFFFFF"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 右下のページ番号（トグルでオンのときだけ常時表示） -->
            <TextBlock
                x:Name="CornerPageNumber"
                Margin="0,0,16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="#59FFFFFF"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!-- 単ページ表示のときの縦の進捗バー（上が先頭）。操作バーと一緒に出現 -->
            <Grid
                x:Name="VerticalProgressHitArea"
                Width="24"
                Margin="0,56,10,56"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="False"
                Opacity="0"
                PointerCanceled="ProgressHitArea_PointerReleased"
                PointerCaptureLost="ProgressHitArea_PointerReleased"
                PointerMoved="ProgressHitArea_PointerMoved"
                PointerPressed="ProgressHitArea_PointerPressed"
                PointerReleased="ProgressHitArea_PointerReleased"
                ToolTipService.ToolTip="クリック・ドラッグでページ移動"
                Visibility="Collapsed">
                <Border
                    Width="4"
                    HorizontalAlignment="Center"
                    Background="#33FFFFFF"
                    CornerRadius="2" />
                <Grid Width="4" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="VerticalProgressDoneRow" Height="0*" />
                        <RowDefinition x:Name="VerticalProgressRestRow" Height="1*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>
            </Grid>

            <!-- 下部の操作バー -->
            <Border
                x:Name="ControlsBar"
                Margin="18"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#D91A1A1E"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                IsHitTestVisible="False"
                Opacity="0">
                <StackPanel Spacing="6">
                    <!-- 全体の進捗（右綴じのときは右から伸びる） -->
                    <!-- バーは細くてクリックしにくいので、透明な Grid で当たり判定を広げる -->
                    <Grid
                        x:Name="ProgressHitArea"
                        Height="16"
                        Margin="8,0"
                        Background="Transparent"
                        PointerCanceled="ProgressHitArea_PointerReleased"
                        PointerCaptureLost="ProgressHitArea_PointerReleased"
                        PointerMoved="ProgressHitArea_PointerMoved"
                        PointerPressed="ProgressHitArea_PointerPressed"
                        PointerReleased="ProgressHitArea_PointerReleased"
                        ToolTipService.ToolTip="クリック・ドラッグでページ移動">
                        <ProgressBar
                            x:Name="ReadingProgress"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Maximum="1"
                            Minimum="0"
                            Value="0" />
                    </Grid>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="PrevButton"
                            Click="PrevButton_Click"
                            Content="&#xE76B;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="前のページ (←)" />

                        <Button
                            x:Name="NextButton"
                            Click="NextButton_Click"
                            Content="&#xE76C;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="次のページ (→)" />

                        <Border
                            Width="1"
                            Height="16"
                            Margin="8,0"
                            Background="#26FFFFFF" />

                        <TextBlock
                            x:Name="PageLabel"
                            MinWidth="96"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="#F2FFFFFF"
                            Text="0 / 0"
                            TextAlignment="Center" />

                        <Border
                            Width="1"
                            Height="16"
                            Margin="8,0"
                            Background="#26FFFFFF" />

                        <DropDownButton
                            x:Name="SpreadButton"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="見開き: なし"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            ToolTipService.ToolTip="見開きの表示方法を変更">
                            <DropDownButton.Flyout>
                                <MenuFlyout
                                    Opening="SpreadFlyout_Opening"
                                    Closed="SpreadFlyout_Closed"
                                    Placement="Top">
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadOffItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="Off"
                                        Text="単ページ" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadCoverItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="CoverSingle"
                                        Text="見開き（表紙のみ単独）" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadPairItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="PairFromStart"
                                        Text="見開き（1ページ目から2枚ずつ）" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SpreadFirstTwoItem"
                                        Click="SpreadModeItem_Click"
                                        GroupName="SpreadMode"
                                        Tag="FirstTwoSingle"
                                        Text="見開き（1・2ページ目のみ単独）" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <ToggleButton
                            x:Name="ReverseKeysToggle"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ReverseKeysToggle_Click"
                            Content="キー反転"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            IsChecked="True"
                            ToolTipService.ToolTip="左右キーと矢印ボタンのページ送り方向を反転" />

                        <ToggleButton
                            x:Name="RtlToggle"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RtlToggle_Click"
                            Content="右綴じ"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            IsChecked="True"
                            ToolTipService.ToolTip="右から左に表示中（クリックで左から右へ）" />

                        <ToggleButton
                            x:Name="PageNumberToggle"
                            MinWidth="0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PageNumberToggle_Click"
                            Content="ページ番号"
                            CornerRadius="8"
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            ToolTipService.ToolTip="右下にページ番号を表示" />

                        <Button
                            x:Name="OpenFileButton"
                            Click="OpenButton_Click"
                            Content="&#xE8E5;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="PDFを開く (Ctrl+O)" />

                        <Button
                            x:Name="FullScreenButton"
                            Click="FullScreenButton_Click"
                            Content="&#xE740;"
                            Style="{StaticResource ViewerIconButtonStyle}"
                            ToolTipService.ToolTip="全画面 (F11)" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ドラッグ中のオーバーレイ -->
            <Border
                x:Name="DropOverlay"
                Background="#B30A0A0C"
                BorderBrush="#FF60CDFF"
                BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="40"
                        Foreground="#FF60CDFF"
                        Glyph="&#xE8E5;" />
                    <TextBlock
                        FontSize="18"
                        Foreground="#F2FFFFFF"
                        Text="PDFをドロップして開く" />
                </StackPanel>
            </Border>
        </Grid>
    </ContentControl>
</Window>
